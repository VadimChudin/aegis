{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AEGIS",
  "version": "0.6.0",
  "identifier": "com.vadimchudin.aegis",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AEGIS",
        "width": 1360,
        "height": 840,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#0a0e16"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../python/aegis_lab/bridges/mt5_bridge.py": "bridges/mt5_bridge.py"
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
